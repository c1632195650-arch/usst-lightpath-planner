{
  "name": "usst-lightpath-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "光溯 · 上理生涯规划助手 (第18届光电杯参赛作品)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test:ui": "node --import ./scripts/register-alias.mjs --test \"scripts/**/*.test.ts\"",
    "test:engine": "node --import ./scripts/register-alias.mjs --test \"tests/**/*.test.ts\"",
    "test:libao": "python scripts/test_libao.py",
    "eval:libao": "python scripts/libao_eval.py",
    "probe:fact": "python scripts/fact_probe.py",
    "probe:reverse": "python scripts/fact_judge_reverse.py",
    "audit:quality": "python scripts/audit_spatial_quality.py",
    "audit:quality:reverse": "python scripts/audit_spatial_quality.py --selftest",
    "audit:quality:baseline": "python scripts/audit_spatial_quality.py --write-baseline",
    "audit:readiness": "python scripts/audit_readiness.py --all",
    "audit:overlap": "python scripts/overlap_accuracy.py --self-test",
    "audit:network": "python scripts/audit_network_quality.py",
    "test:campus": "python scripts/test_campus.py",
    "vocab:check": "python server/campus_vocab.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
