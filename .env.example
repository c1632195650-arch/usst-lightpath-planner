# 复制这个文件为 .env.local，填入你自己的 Key
# ⚠️ .env.local 已在 .gitignore 中，绝不会被提交
# ⚠️ 绝不把 Key 直接写进源码，也绝不贴到聊天框 / GitHub Issue / 截图里

# 大模型 API Key（P1-B，没有也能跑，产品会走降级话术）
VITE_AI_API_KEY=

# 可选：自定义接口地址
VITE_AI_BASE_URL=https://api.deepseek.com
VITE_AI_MODEL=deepseek-chat

# ---- 梨宝后端（server/app.py）----
# CORS 白名单（逗号分隔）。默认只放行本机前端；
# 手机局域网真机测试时临时放开：LIBAO_CORS_ORIGINS=http://localhost:5173,http://192.168.x.x:5173
LIBAO_CORS_ORIGINS=
# 路由阈值（默认 0.68/0.56，针对 bge-small-zh-v1.5 校准，换模型需重新标定）
# RAW_HIGH=0.68
# RAW_LOW=0.56
